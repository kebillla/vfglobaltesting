# ==========================================================================
# Переменные окружения. Задаются в Vercel: Project → Settings → Environment
# Variables. В репозиторий реальные значения НЕ коммитим — этот файл только
# как список того, что нужно заполнить.
# ==========================================================================

# --- Robokassa (казахстанский аккаунт) ------------------------------------
ROBOKASSA_LOGIN=              # ИДЕНТИФИКАТОР МАГАЗИНА (не логин от аккаунта!)
# ^ Кабинет → Мои магазины → Технические настройки
ROBOKASSA_PASSWORD_1=         # боевой пароль #1 — подпись запроса на оплату
ROBOKASSA_PASSWORD_2=         # боевой пароль #2 — проверка колбэка ResultURL
ROBOKASSA_TEST_PASSWORD_1=    # ТЕСТОВЫЙ пароль #1 (отдельная пара, из тех же настроек)
ROBOKASSA_TEST_PASSWORD_2=    # ТЕСТОВЫЙ пароль #2
# ^ при ROBOKASSA_TEST=1 подписи считаются ТОЛЬКО тестовыми паролями
ROBOKASSA_ENDPOINT=https://auth.robokassa.kz/Merchant/Payment/Index
ROBOKASSA_HASH_ALGO=md5       # должен совпадать с настройкой в кабинете (md5 | sha256)
ROBOKASSA_TEST=1              # 1 — тестовый режим, 0 — боевой
# ROBOKASSA_OUT_SUM_CURRENCY= # оставить пустым, если магазин уже в тенге

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=           # токен бота от @BotFather
TELEGRAM_CHAT_ID=             # id закрытого канала, вида -1001234567890
TELEGRAM_INVITE_TTL_HOURS=48  # сколько часов живёт персональная ссылка

# --- Хранилище заказов (Upstash Redis, бесплатный тариф) ------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Почта (Resend; нужен подтверждённый домен) ---------------------------
RESEND_API_KEY=
MAIL_FROM=VolFix Global <noreply@ваш-домен.kz>

# --- Товар и цена ----------------------------------------------------------
PRICE_AMOUNT=10000
PRICE_CURRENCY=KZT
PRODUCT_CODE=group_access
PRODUCT_TITLE=Доступ в закрытую группу VolFix Global

# --- Выгрузка истории заказов ---------------------------------------------
ADMIN_TOKEN=                  # придумайте длинную случайную строку
